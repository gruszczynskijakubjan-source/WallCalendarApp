# Database (SQLite file). In Docker this points at a mounted volume.
DATABASE_URL="file:./data/dev.db"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
# Enable "Google Calendar API" and "Google Tasks API" for the project.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#   (and http://<home-server-ip>:3000/api/auth/callback/google for LAN access)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Weather widget (Open-Meteo, no API key needed). Default location shown in
# the calendar header unless a device overrides it with its own GPS location
# in Settings. Find coordinates e.g. via https://www.google.com/maps.
WEATHER_LAT="52.2297"
WEATHER_LON="21.0122"
WEATHER_LABEL="Warszawa"
