generator client {
  provider   = "prisma-client-js"
  // No Rust query-engine binary in the generated Client — required to run
  // on Termux/Android, where Prisma's prebuilt engines (built for glibc/musl)
  // are ABI-incompatible with Android's Bionic libc.
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth models (adapted for @auth/prisma-adapter)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // User-uploaded profile photo (data URL), overrides `image` when set.
  // Kept separate from `image` since NextAuth refreshes that from Google on
  // every sign-in.
  customImage   String?
  // Which "household member" this account belongs to, e.g. "husband" / "wife"
  householdRole String?

  accounts Account[]
  sessions Session[]
  todos    Todo[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Shared household todo list (independent from Google Tasks)
model Todo {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
}

// Family photos for the fullscreen slideshow ("digital picture frame" mode).
model Photo {
  id        String   @id @default(cuid())
  dataUrl   String
  createdAt DateTime @default(now())
}

// Single, app-wide Trello connection (not per Google account) powering the
// "Lista zakupów" view. Expected to have at most one row.
model TrelloConnection {
  id        String   @id @default(cuid())
  apiKey    String
  token     String
  boardId   String?
  boardName String?
  listId    String?
  listName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Single, app-wide eWeLink (Sonoff) connection powering the smart-home
// device panel. Expected to have at most one row. `region` is the eWeLink
// API region prefix (e.g. "eu", "us", "as") returned at OAuth time — API
// calls must be routed to the matching regional host.
model EweLinkConnection {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  region       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
